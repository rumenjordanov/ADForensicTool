__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
build/
dist/
.venv/
venv/

# Real event log exports and generated reports are evidence/PII-bearing --
# never commit them. The one exception is examples/sample_report.xlsx,
# which is built entirely from synthetic data (see
# examples/generate_sample_report.py) and is safe/intended to be checked in.
*.evtx
*.xlsx
!tests/fixtures/*.xlsx
!tests/fixtures/*.evtx
!examples/sample_report.xlsx

.vscode/
.idea/

# Test/coverage artifacts (coverage data embeds absolute local paths)
.coverage
.coverage.*
coverage.xml
htmlcov/
.ruff_cache/
